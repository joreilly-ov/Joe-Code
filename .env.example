# OVCD Dashboard — Environment Variables
# Copy this file to .env and fill in values for SCHEDULED runs only.
# For manual (on-demand) runs, leave these blank — the browser will open for you to log in.

# OVCD_USERNAME=your.email@oneviewhealthcare.com
# OVCD_PASSWORD=your-password-here

# Optional: change the port the dashboard runs on (default: 3000)
# PORT=3000
